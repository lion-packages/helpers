{
    "name": "lion/helpers",
    "description": "Easy-to-use helpers for handling chains or arrangements.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lion\\Helpers\\": "src/LionHelpers/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "lion/test": "^2.0 || ^3.0 || ^4.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11 || ^4.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "overtrue/phplint": "^9.5",
        "infection/infection": "^0.29.14 || ^0.31.0 || ^0.32.0 || ^0.33.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
